PORT=3000
# Local MongoDB: mongodb://localhost:27017/nalam360
MONGO_URI=mongodb+srv://<username>:<url-encoded-password>@<cluster-host>/nalam360?retryWrites=true&w=majority
TOKEN_SECRET=replace-with-a-long-random-secret
NODE_ENV=development

# Optional private admin bootstrap
ADMIN_NAME=Nalam Administrator
ADMIN_MOBILE=9999999999
ADMIN_PASSWORD=replace-with-a-private-password
ADMIN_VILLAGE=Central Office

# Optional private doctor bootstrap
DOCTOR_NAME=Nalam Doctor
DOCTOR_MOBILE=9888888888
DOCTOR_PASSWORD=replace-with-a-private-password
DOCTOR_VILLAGE=Central Office
